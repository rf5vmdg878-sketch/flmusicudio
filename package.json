{
  "name": "flmusicudio",
  "version": "0.1.0",
  "description": "Open-source beat studio / DAW — step sequencer, piano roll, playlist, mixer and synth/sampler engine, inspired by classic workflow DAWs.",
  "author": {
    "name": "Beat Forge Studio Contributors",
    "email": "noreply@beatforgestudio.example"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"npm:dev\" \"npm:electron:watch:tsc\" \"npm:electron:watch:run\"",
    "electron:watch:tsc": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:watch:run": "wait-on dist-electron/main.js tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync('electron/runtime-package.json','dist-electron/package.json')\"",
    "package": "npm run build && npm run build:electron && electron-builder --mac --win --linux",
    "package:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "package:win": "npm run build && npm run build:electron && electron-builder --win",
    "package:linux": "npm run build && npm run build:electron && electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.beatforge.studio",
    "productName": "Beat Forge Studio",
    "copyright": "Copyright (c) 2026 Beat Forge Studio contributors",
    "icon": "build/icon.png",
    "publish": null,
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] },
        { "target": "portable", "arch": ["x64", "arm64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "rpm", "arch": ["x64", "arm64"] }
      ],
      "category": "Audio"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.14.15",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^7.2.0"
  }
}
